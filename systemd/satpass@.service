[Unit]
Description=Satellite pass prediction session (connection %i)

[Service]
Type=simple

# Run as the same user/group that owns LinBPQ.
User=linbpq
Group=linbpq

# Edit this path to match your installation.
WorkingDirectory=/opt/linbpq/services/satpass

StandardInput=socket
StandardOutput=socket
StandardError=journal

# Edit this path to match your installation.
ExecStart=/opt/linbpq/services/satpass/satpass-wrapper.sh

# Clean shutdown and 5-minute session limit.
TimeoutStopSec=10
RuntimeMaxSec=300
